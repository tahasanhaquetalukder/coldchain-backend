# Copy this file to backend/.env and fill in what you use. Everything here is a placeholder.
# python-dotenv reads backend/.env (or the repo root's) at import time, so a change needs a restart
# of uvicorn, not a reload of the web page. Never commit the filled-in file - .env is gitignored.

# ---------------------------------------------------------------- the server
# production | anything else. "production" refuses to boot on a missing or placeholder
# JWT_SECRET/HMAC_SECRET_KEY, refuses to seed a login without its SEED_*_PASSWORD, and stops
# allowing "*" in CORS. Leave it unset locally.
ENV=development

# A blank or missing DATABASE_URL means local SQLite (./coldchain.db, in whatever directory uvicorn
# was started from) - that is the right answer for the demo and for every test. Set it only for a
# real server. postgres://, postgresql:// and postgresql+anything:// are all normalised to
# postgresql:// so the pinned psycopg2-binary is the only driver needed.
DATABASE_URL=

# ---------------------------------------------------------------- secrets
# Generate each one: python -c "import secrets; print(secrets.token_hex(32))"
# Signs session tokens. Rotating it signs everyone out, which is the point of rotating it.
JWT_SECRET=
# The FLEET key: only nodes that were never registered individually sign with it. Every node added
# through the Devices page gets its own key and ignores this one. Rotating it means rotating or
# reflashing anything still on the fleet key.
HMAC_SECRET_KEY=

# ---------------------------------------------------------------- who may call this API from a browser
# Comma-separated exact origins, e.g. https://coldchain-web.onrender.com
# Unset in development means * (any page); in production it must name the one site you serve.
CORS_ORIGINS=

# ---------------------------------------------------------------- the three logins
# In production these are mandatory: the seed refuses to create admin/admin123 on a deployed API.
# They only apply while the users table is empty, so set them before the first deploy.
SEED_ADMIN_PASSWORD=
SEED_PHARMACIST_PASSWORD=
SEED_INSPECTOR_PASSWORD=

# ---------------------------------------------------------------- optional door alert
# Both must be set or the alert stays in the audit log and nothing is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- audit anchor file
# Append-only copy of the newest record hash, kept out of the database so a whole-log deletion is
# still detectable. Put it somewhere the .db file is not.
AUDIT_ANCHOR=audit_anchor.log

# ---------------------------------------------------------------- the helpers that are not the server
# Where simulator.py and backend/mqtt_bridge.py post their readings.
API_BASE=http://127.0.0.1:8000
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Only needed for a cloud broker. Leave both blank to keep the local anonymous 1883 demo exactly as
# it is. MQTT_TLS=1 switches the bridge to TLS (which is what port 8883 expects).
MQTT_USER=
MQTT_PASS=
MQTT_TLS=0

# ---------------------------------------------------------------- the web app (not read from here)
# Vite only reads frontend/.env(.local) / frontend/.env.example, and bakes the value in at build
# time, so a published site has to be rebuilt after changing it.
# VITE_API_BASE=http://127.0.0.1:8000
