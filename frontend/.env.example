# Copy to frontend/.env.local for a local override, or set the same key in the hosting dashboard.
#
# Vite bakes this into the bundle at build time, so changing it needs `npm run build` again - a
# running `npm run dev` picks it up on restart. Nothing else in this project reads it.

# The API the web app calls. Leave it unset for local development: the dev server then talks to
# http://127.0.0.1:8000 on its own. A published site must set its API's real https origin, with no
# trailing slash - an unset value makes the bundle call the static host, which has no /api routes.
VITE_API_BASE=http://127.0.0.1:8000
